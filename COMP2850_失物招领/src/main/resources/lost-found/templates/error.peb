{% extends "base.peb" %}{% block title %}Request error{% endblock %}{% block body %}<div class="narrow"><a class="back" href="/lost-found">← Item board</a><div class="error-box" role="alert"><p class="ref">{{ problem.code }}</p><h1 class="inner-title">{{ problem.message }}</h1><a class="button primary" href="/lost-found">Back to item board</a></div></div>{% endblock %}
