<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Lost &amp; found{% endblock %} · Campus services</title>
<link rel="stylesheet" href="/lost-found/assets/main.css"><script src="/lost-found/assets/main.js" defer></script></head>
<body><a class="skip" href="#main">Skip to content</a>
<header class="bar"><div class="wrap bar-inner"><a class="brand" href="/lost-found"><span class="brand-mark" aria-hidden="true"></span>Campus services</a>
<nav aria-label="Lost and found"><a href="/lost-found" class="board-link">Item board</a><a class="button header-button" href="/lost-found/new"><span aria-hidden="true">＋</span> Upload an item</a></nav></div></header>
<main id="main" class="wrap">{% block body %}{% endblock %}</main>
</body></html>
